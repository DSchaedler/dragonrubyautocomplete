{
  "name": "dragonruby-autocomplete",
  "displayName": "DragonRuby Autocomplete",
  "description": "Autocomplete support for DragonRuby game code in VS Code.",
  "version": "0.0.13",
  "publisher": "DeeSchaedler",
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/DSchaedler/dragonrubyautocomplete.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:ruby"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dragonruby.enableProjectAutocomplete",
        "title": "DragonRuby: Enable autocomplete for this project"
      },
      {
        "command": "dragonruby.disableProjectAutocomplete",
        "title": "DragonRuby: Disable autocomplete for this project"
      },
      {
        "command": "dragonruby.resetProjectAutocomplete",
        "title": "DragonRuby: Reset autocomplete for this project"
      },
      {
        "command": "dragonruby.toggleProjectAutocomplete",
        "title": "DragonRuby: Toggle autocomplete for this project"
      },
      {
        "command": "dragonruby.rescanEngine",
        "title": "DragonRuby: Rescan engine completions"
      },
      {
        "command": "dragonruby.clearDerivedCompletions",
        "title": "DragonRuby: Clear engine-derived completions"
      },
      {
        "command": "dragonruby.showProjectStatus",
        "title": "DragonRuby: Show project status"
      }
    ],
    "configuration": {
      "title": "DragonRuby Autocomplete",
      "properties": {
        "dragonruby-autocomplete.rescanEngine": {
          "type": "boolean",
          "default": false,
          "description": "Trigger a full engine rescan for the current project. This resets to false after running."
        },
        "dragonruby-autocomplete.clearDerivedCompletions": {
          "type": "boolean",
          "default": false,
          "description": "Clear engine-derived, non-hardcoded completions for the current project. This resets to false after running."
        }
      }
    }
  },
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "npm run compile && node --test ./out/**/*.test.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.5"
  }
}
